<?php

/**
 * @file
 * Install, update and uninstall functions for the module.
 */

/**
 * Implements hook_schema().
 */
function analyze_ai_content_marketing_audit_schema() {
  $schema = [];

  // Table for content marketing audit factors (like sentiment types).
  $schema['analyze_ai_content_marketing_audit_factors'] = [
    'description' => 'Stores content marketing audit factors for AI analysis.',
    'fields' => [
      'id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Primary key: unique factor identifier.',
      ],
      'label' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Human-readable factor label.',
      ],
      'description' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Factor description.',
      ],
      'type' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'quantitative',
        'description' => 'Factor type: quantitative or qualitative.',
      ],
      'options' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'JSON array of discrete options for qualitative factors.',
      ],
      'weight' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Factor weight for ordering.',
      ],
      'status' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
        'description' => 'Factor status (1 = enabled, 0 = disabled).',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'weight' => ['weight'],
      'status' => ['status'],
      'type' => ['type'],
      'type_status' => ['type', 'status'],
    ],
  ];

  // Table for content marketing audit analysis results.
  $schema['analyze_ai_content_marketing_audit_results'] = [
    'description' => 'Stores AI content marketing audit analysis results.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key: unique analysis result ID.',
      ],
      'entity_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'The entity type that was analyzed.',
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'The entity ID that was analyzed.',
      ],
      'entity_revision_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'The entity revision ID that was analyzed.',
      ],
      'langcode' => [
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'description' => 'The language code of the analyzed content.',
      ],
      'factor_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The factor that was analyzed.',
      ],
      'score' => [
        'type' => 'float',
        'not null' => TRUE,
        'description' => 'The analysis score (-1.0 to 1.0).',
      ],
      'content_hash' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'SHA256 hash of the analyzed content.',
      ],
      'config_hash' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'MD5 hash of the analysis configuration.',
      ],
      'analyzed_timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Unix timestamp when analysis was performed.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'entity_factor_lang' => ['entity_type', 'entity_id', 'factor_id', 'langcode'],
    ],
    'indexes' => [
      'content_hash' => ['content_hash'],
      'factor' => ['factor_id'],
      'analyzed_timestamp' => ['analyzed_timestamp'],
      'entity_type_bundle' => ['entity_type', 'entity_id'],
    ],
    'foreign keys' => [
      'factor' => [
        'table' => 'analyze_ai_content_marketing_audit_factors',
        'columns' => ['factor_id' => 'id'],
      ],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function analyze_ai_content_marketing_audit_install() {
  // Create tables from schema.
  $schema = analyze_ai_content_marketing_audit_schema();
  $database = \Drupal::database();
  foreach ($schema as $table_name => $table_spec) {
    if (!$database->schema()->tableExists($table_name)) {
      $database->schema()->createTable($table_name, $table_spec);
    }
  }

  // Insert default content marketing audit factors.
  $factors = [
    // Quantitative factors (scored -1.0 to 1.0)
    'usability' => [
      'label' => 'Usability',
      'description' => 'How easy is the content to understand and act upon for the target audience?',
      'type' => 'quantitative',
      'weight' => 0,
    ],
    'knowledge_level' => [
      'label' => 'Knowledge Level',
      'description' => 'How well does the content demonstrate expertise and authority on the topic?',
      'type' => 'quantitative',
      'weight' => 1,
    ],
    'actionability' => [
      'label' => 'Actionability',
      'description' => 'How well does the content provide clear next steps or actionable insights?',
      'type' => 'quantitative',
      'weight' => 2,
    ],
    'accuracy' => [
      'label' => 'Accuracy',
      'description' => 'How factually correct and up-to-date is the content?',
      'type' => 'quantitative',
      'weight' => 3,
    ],
    'business_value' => [
      'label' => 'Business Value',
      'description' => 'How well does the content support business goals and provide value to stakeholders?',
      'type' => 'quantitative',
      'weight' => 4,
    ],
    'messaging' => [
      'label' => 'Messaging',
      'description' => 'How clear, compelling, and consistent is the messaging?',
      'type' => 'quantitative',
      'weight' => 5,
    ],
    'brand_voice_fit' => [
      'label' => 'Brand Voice Fit',
      'description' => 'How well does the content align with the brand voice and tone guidelines?',
      'type' => 'quantitative',
      'weight' => 6,
    ],
      // Qualitative factors (categorical classification)
    'funnel_stage' => [
      'label' => 'Funnel Stage',
      'description' => 'Which stage of the marketing funnel does this content primarily target?',
      'type' => 'qualitative',
      'options' => ['Awareness', 'Consideration', 'Decision', 'Retention'],
      'weight' => 100,
    ],
  ];

  $database = \Drupal::database();
  foreach ($factors as $id => $factor) {
    $database->insert('analyze_ai_content_marketing_audit_factors')
      ->fields([
        'id' => $id,
        'label' => $factor['label'],
        'description' => $factor['description'],
        'type' => $factor['type'],
        'options' => isset($factor['options']) ? json_encode($factor['options']) : NULL,
        'weight' => $factor['weight'],
        'status' => 1,
      ])
      ->execute();
  }
}

/**
 * Implements hook_uninstall().
 */
function analyze_ai_content_marketing_audit_uninstall() {
  // Clean up any remaining data if tables exist.
  $database = \Drupal::database();
  $schema = $database->schema();

  if ($schema->tableExists('analyze_ai_content_marketing_audit_factors')) {
    $database->delete('analyze_ai_content_marketing_audit_factors')->execute();
  }

  if ($schema->tableExists('analyze_ai_content_marketing_audit_results')) {
    $database->delete('analyze_ai_content_marketing_audit_results')->execute();
  }
}

/**
 * Update plugin ID to ensure consistent analyzer naming convention.
 */
function analyze_ai_content_marketing_audit_update_8001() {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('analyze.settings');
  $status = $config->get('status') ?? [];
  $updated = FALSE;

  // List of potential old plugin IDs that might need updating.
  $old_plugin_ids = [
    'ai_content_marketing_audit_analyzer',
    'content_marketing_audit_analyzer',
  ];

  // Update plugin IDs in analyze.settings configuration.
  foreach ($status as $entity_type => $bundles) {
    foreach ($bundles as $bundle => $analyzers) {
      foreach ($old_plugin_ids as $old_id) {
        if (isset($analyzers[$old_id])) {
          // Copy old setting to new plugin ID.
          $analyzers['analyze_ai_content_marketing_audit_analyzer'] = $analyzers[$old_id];
          // Remove old plugin ID.
          unset($analyzers[$old_id]);
          // Update the configuration.
          $status[$entity_type][$bundle] = $analyzers;
          $updated = TRUE;
        }
      }
    }
  }

  if ($updated) {
    $config->set('status', $status)->save();
    return t('Updated content marketing audit analyzer plugin ID to "analyze_ai_content_marketing_audit_analyzer" in analyze settings.');
  }

  return t('No content marketing audit analyzer settings found to update.');
}

/**
 * Update view: factor_id filter, language filter, and submit button.
 */
function analyze_ai_content_marketing_audit_update_8002() {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('views.view.ai_content_marketing_audit_results');

  if ($config->isNew()) {
    return t('View not found.');
  }

  $filters = $config->get('display.default.display_options.filters') ?? [];

  // Update factor_id filter to use analyze_select.
  foreach ($filters as $filter_id => $filter) {
    if (($filter['field'] ?? '') === 'factor_id' && ($filter['plugin_id'] ?? '') === 'string') {
      $filters[$filter_id]['plugin_id'] = 'analyze_select';
      $filters[$filter_id]['operator'] = 'in';
      $filters[$filter_id]['value'] = [];
    }
  }

  // Remove old langcode filter if present.
  unset($filters['langcode']);

  // Add language filter using node relationship.
  $langcode_filter = [
    'id' => 'langcode',
    'table' => 'node_field_data',
    'field' => 'langcode',
    'relationship' => 'entity_id',
    'group_type' => 'group',
    'admin_label' => '',
    'entity_type' => 'node',
    'entity_field' => 'langcode',
    'plugin_id' => 'language',
    'operator' => 'in',
    'value' => [
      '***LANGUAGE_site_default***' => '***LANGUAGE_site_default***',
    ],
    'group' => 1,
    'exposed' => TRUE,
    'expose' => [
      'operator_id' => 'langcode_op',
      'label' => 'Translation language',
      'description' => '',
      'use_operator' => FALSE,
      'operator' => 'langcode_op',
      'operator_limit_selection' => FALSE,
      'operator_list' => [],
      'identifier' => 'langcode',
      'required' => FALSE,
      'remember' => FALSE,
      'multiple' => FALSE,
      'remember_roles' => [
        'authenticated' => 'authenticated',
      ],
      'reduce' => FALSE,
    ],
    'is_grouped' => FALSE,
    'group_info' => [
      'label' => '',
      'description' => '',
      'identifier' => '',
      'optional' => TRUE,
      'widget' => 'select',
      'multiple' => FALSE,
      'remember' => FALSE,
      'default_group' => 'All',
      'default_group_multiple' => [],
      'group_items' => [],
    ],
  ];

  // Add langcode filter at the beginning.
  $filters = ['langcode' => $langcode_filter] + $filters;
  $config->set('display.default.display_options.filters', $filters);

  // Standardize submit button.
  $config->set('display.default.display_options.exposed_form.options.submit_button', 'Apply filters');

  $config->save();

  return t('Updated view filters and submit button.');
}

/**
 * Add unique constraint, view fields, filters, and standardize display.
 */
function analyze_ai_content_marketing_audit_update_8003() {
  $changes = [];

  // Part 1: Add unique constraint and clean up duplicate results.
  $database = \Drupal::database();
  $db_schema = $database->schema();
  $table = 'analyze_ai_content_marketing_audit_results';

  $duplicates = $database->query("
    SELECT t1.id
    FROM {$table} t1
    INNER JOIN {$table} t2
    ON t1.entity_type = t2.entity_type
      AND t1.entity_id = t2.entity_id
      AND t1.factor_id = t2.factor_id
      AND t1.langcode = t2.langcode
      AND t1.analyzed_timestamp < t2.analyzed_timestamp
  ")->fetchCol();

  if (!empty($duplicates)) {
    $database->delete($table)
      ->condition('id', $duplicates, 'IN')
      ->execute();
    $changes[] = 'cleaned up ' . count($duplicates) . ' duplicate records';
  }

  try {
    $db_schema->addUniqueKey($table, 'entity_factor_lang', ['entity_type', 'entity_id', 'factor_id', 'langcode']);
    $changes[] = 'unique constraint';
  }
  catch (\Exception $e) {
    // Constraint may already exist.
  }

  // Part 2: Update view configuration.
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('views.view.ai_content_marketing_audit_results');

  if ($config->isNew()) {
    return t('View not found. Database changes: @changes', ['@changes' => implode(', ', $changes)]);
  }

  // Add content type filter if not present.
  $filters = $config->get('display.default.display_options.filters') ?? [];
  if (!isset($filters['type'])) {
    $type_filter = [
      'id' => 'type',
      'table' => 'node_field_data',
      'field' => 'type',
      'relationship' => 'entity_id',
      'group_type' => 'group',
      'admin_label' => '',
      'entity_type' => 'node',
      'entity_field' => 'type',
      'plugin_id' => 'bundle',
      'operator' => 'in',
      'value' => [],
      'group' => 1,
      'exposed' => TRUE,
      'expose' => [
        'operator_id' => 'type_op',
        'label' => 'Content type',
        'description' => '',
        'use_operator' => FALSE,
        'operator' => 'type_op',
        'operator_limit_selection' => FALSE,
        'operator_list' => [],
        'identifier' => 'type',
        'required' => FALSE,
        'remember' => FALSE,
        'multiple' => FALSE,
        'remember_roles' => ['authenticated' => 'authenticated'],
        'reduce' => FALSE,
      ],
      'is_grouped' => FALSE,
      'group_info' => [
        'label' => '',
        'description' => '',
        'identifier' => '',
        'optional' => TRUE,
        'widget' => 'select',
        'multiple' => FALSE,
        'remember' => FALSE,
        'default_group' => 'All',
        'default_group_multiple' => [],
        'group_items' => [],
      ],
    ];
    $filters = ['type' => $type_filter] + $filters;
    $config->set('display.default.display_options.filters', $filters);
    $changes[] = 'content type filter';
  }

  // Define field templates.
  $alter_defaults = [
    'alter_text' => FALSE,
    'text' => '',
    'make_link' => FALSE,
    'path' => '',
    'absolute' => FALSE,
    'external' => FALSE,
    'replace_spaces' => FALSE,
    'path_case' => 'none',
    'trim_whitespace' => FALSE,
    'alt' => '',
    'rel' => '',
