<?php

/**
 * @file
 * Analyze AI Content Marketing Audit module for AI-powered content analysis.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\analyze_ai_content_marketing_audit\Hook\AnalyzeAiContentMarketingAuditHooks;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_color_scale_popover_alter().
 */
#[LegacyHook]
function analyze_ai_content_marketing_audit_views_color_scale_popover_alter(array &$content, array $context): void {
  \Drupal::service(AnalyzeAiContentMarketingAuditHooks::class)->viewsColorScalePopoverAlter($content, $context);
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function analyze_ai_content_marketing_audit_help($route_name, $route_match) {
  return \Drupal::service(AnalyzeAiContentMarketingAuditHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_views_pre_view().
 */
#[LegacyHook]
function analyze_ai_content_marketing_audit_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  \Drupal::service(AnalyzeAiContentMarketingAuditHooks::class)->viewsPreView($view, $display_id, $args);
}
